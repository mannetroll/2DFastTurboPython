execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY
  "${EXE}" --help RESULT_VARIABLE status OUTPUT_VARIABLE output)
if(NOT status EQUAL 0 OR NOT output MATCHES "Dear ImGui")
  message(FATAL_ERROR "Native help requires a GPU/display or omits backend: ${output}")
endif()
foreach(arg --unknown --resolution --device --interval-ms)
  execute_process(COMMAND "${EXE}" "${arg}" RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT error MATCHES "option|value")
    message(FATAL_ERROR "Invalid argument ${arg} was not rejected: ${error}")
  endif()
endforeach()
execute_process(COMMAND "${EXE}" --benchmark-seconds 0 RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT error MATCHES "positive")
  message(FATAL_ERROR "Zero benchmark duration must fail instead of launching an interactive window: ${error}")
endif()
foreach(value nan inf -1 0 3 10001)
  execute_process(COMMAND "${EXE}" --interval-ms "${value}" RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
  if(status EQUAL 0 OR NOT error MATCHES "value|interval")
    message(FATAL_ERROR "Invalid interval ${value} was not rejected: ${error}")
  endif()
endforeach()
