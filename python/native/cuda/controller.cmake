# Shared, guarded host adaptation of the reference controller. No solver edits.
if(NOT FASTTURBO_WINDOWS)
  message(FATAL_ERROR "FASTTURBO_WINDOWS must name the reference-windows source directory.")
endif()
foreach(name controller.cpp controller.hpp)
  if(NOT EXISTS "${FASTTURBO_WINDOWS}/src/${name}")
    message(FATAL_ERROR "Missing reference source: ${FASTTURBO_WINDOWS}/src/${name}")
  endif()
endforeach()
set(adapted "${CMAKE_CURRENT_BINARY_DIR}/adapted")
file(MAKE_DIRECTORY "${adapted}")
function(adapt name before after)
  file(READ "${adapted}/${name}" code)
  string(FIND "${code}" "${before}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Reference ${name} changed; review the documented adaptation.")
  endif()
  string(REPLACE "${before}" "${after}" code "${code}")
  file(WRITE "${adapted}/${name}" "${code}")
endfunction()
foreach(name controller.cpp controller.hpp)
  configure_file("${FASTTURBO_WINDOWS}/src/${name}" "${adapted}/${name}" COPYONLY)
endforeach()
# Benchmark options are consumed only at generation boundaries on the worker.
adapt(controller.hpp "void configure(Config config);" "void configure(Config config);\n    void benchmark(const Options& value);")
adapt(controller.hpp "Options options;" "Options pendingOptions;")
adapt(controller.cpp ":options(o),device(d)" ":pendingOptions(o),device(d)")
adapt(controller.cpp "void Controller::reset()" "void Controller::benchmark(const Options& value){std::lock_guard lock(mutex);pendingOptions=value;}\nvoid Controller::reset()")
adapt(controller.cpp "std::unique_ptr<Solver> core;" "std::unique_ptr<Solver> core;\n    Options options;")
adapt(controller.cpp "generation=r.generation;failed=false;" "{std::lock_guard lock(mutex); options=pendingOptions;}\n                generation=r.generation;failed=false;")
