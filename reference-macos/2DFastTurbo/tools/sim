#!/bin/bash
# Build the shared native Swift/Metal CNAB2 core, then replace this launcher.
set -euo pipefail
sim_here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
sim_root=$(cd -- "$sim_here/.." && pwd)
sim_cache="$sim_here/.build"
sim_core="$sim_root/Sources/FastTurboCore"
sim_bridge="$sim_root/Sources/Bridge"
sim_vendor="$sim_root/ThirdParty/VkFFTSource"
sim_sdk=$(xcrun --sdk macosx --show-sdk-path)
sim_arch=$(uname -m)
sim_target="$sim_arch-apple-macos15.0"
mkdir -p "$sim_cache"
sim_sources=("$sim_core/FastTurboTypes.swift" "$sim_core/FastTurboCNAB2.swift"
             "$sim_core/FastTurboCNAB2Shaders.swift" "$sim_here/CNAB2Comparison.swift")
sim_digest=$({
    xcrun swiftc --version 2>&1
    printf '%s\n' "$sim_sdk" "$sim_target"
    shasum -a 256 "$sim_here/sim" "${sim_sources[@]}" "$sim_bridge"/*
    find "$sim_vendor/vkFFT" "$sim_vendor/metal-cpp" -type f \( -name '*.h' -o -name '*.hpp' \) -print0 | sort -z | xargs -0 shasum -a 256
} | shasum -a 256)
sim_binary="$sim_cache/cnab2-${sim_digest%% *}"
if [[ ! -x "$sim_binary" ]]; then
    printf '%s\n' 'Building native Swift/Metal CNAB2…' >&2
    sim_build=$(mktemp -d "$sim_cache/compile-XXXXXX")
    trap 'rm -rf -- "$sim_build"' EXIT
    sim_flags=(-O3 -std=c++20 -isysroot "$sim_sdk" -target "$sim_target"
               -I "$sim_bridge" -isystem "$sim_vendor/vkFFT" -isystem "$sim_vendor/metal-cpp")
    xcrun clang++ "${sim_flags[@]}" -c "$sim_bridge/MTTVkFFTCore.cpp" -o "$sim_build/core.o" >&2
    xcrun clang++ "${sim_flags[@]}" -fobjc-arc -c "$sim_bridge/MTTVkFFTBackend.mm" -o "$sim_build/backend.o" >&2
    xcrun swiftc -swift-version 5 -O -whole-module-optimization -parse-as-library -sdk "$sim_sdk" -target "$sim_target" \
        -module-cache-path "$sim_cache/modules" -import-objc-header "$sim_bridge/MTTFFT2DBackend.h" \
        "${sim_sources[@]}" "$sim_build/core.o" "$sim_build/backend.o" -lc++ \
        -framework Metal -framework Foundation -o "$sim_build/sim" >&2
    mv -f "$sim_build/sim" "$sim_binary"
    rm -rf -- "$sim_build"
    trap - EXIT
fi
if [[ "${1:-}" == "--build-only" ]]; then
    printf '%s\n' "$sim_binary"
    exit 0
fi
exec "$sim_binary" "$@"
